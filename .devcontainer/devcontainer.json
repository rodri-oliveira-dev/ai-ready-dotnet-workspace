{
  "name": "AI-ready .NET workspace",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0-noble@sha256:694076b55f447d4b9f5b49bc6616c2e904d63e1a61e43680b2bbea46011b6783",
  "containerUser": "vscode",
  "remoteUser": "vscode",
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges:true"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "rodrioliveira.adr-guard"
      ],
      "settings": {
        "dotnet.defaultSolution": "AiReadyWorkspace.slnx",
        "editor.formatOnSave": true,
        "adrGuard.validation.directory": "docs/adr",
        "adrGuard.validation.adrFormat": "canonical",
        "adrGuard.validation.onSave": false
      }
    }
  }
}
